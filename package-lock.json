{
  "name": "cialai-platform",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "cialai-platform",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": "22.x",
        "npm": "10.x"
      }
    },
    "apps/desktop": {
      "name": "@cialai/desktop",
      "version": "0.1.0",
      "license": "Apache-2.0"
    },
    "apps/mobile": {
      "name": "@cialai/mobile",
      "version": "0.1.0",
      "license": "Apache-2.0"
    },
    "node_modules/@cialai/desktop": {
      "resolved": "apps/desktop",
      "link": true
    },
    "node_modules/@cialai/mobile": {
      "resolved": "apps/mobile",
      "link": true
    },
    "node_modules/@cialai/protocol": {
      "resolved": "packages/protocol",
      "link": true
    },
    "node_modules/@cialai/tunnel-core": {
      "resolved": "packages/tunnel-core",
      "link": true
    },
    "node_modules/@cialai/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "packages/protocol": {
      "name": "@cialai/protocol",
      "version": "0.1.0",
      "license": "Apache-2.0"
    },
    "packages/tunnel-core": {
      "name": "@cialai/tunnel-core",
      "version": "0.1.0",
      "license": "Apache-2.0"
    },
    "packages/ui": {
      "name": "@cialai/ui",
      "version": "0.1.0",
      "license": "Apache-2.0"
    }
  }
}
