{
  "name": "@cialai/desktop",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "npm run sidecar && tauri dev",
    "vite": "vite",
    "build": "npm run sidecar && tauri build",
    "sidecar": "node ../../tools/build-tunnel.mjs --local",
    "build:ui": "vite build && npm run build:mobile-resource",
    "build:mobile-resource": "vite build --mode mobile-resource && node ../../tools/check/mobile-resource.mjs",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "icon": "tauri icon design/desktop-icon-1024.png"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@vitejs/plugin-react": "5.2.0",
    "vite": "7.3.6"
  }
}
