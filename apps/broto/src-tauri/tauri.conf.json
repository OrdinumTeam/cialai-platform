{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CialaiBroto",
  "version": "0.1.2",
  "identifier": "br.com.ordinum.cialai.broto",
  "build": {
    "beforeDevCommand": "npm run vite",
    "beforeBuildCommand": "npm run build:ui",
    "devUrl": "http://127.0.0.1:1422",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cialai Broto",
        "width": 620,
        "height": 640,
        "minWidth": 360,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
