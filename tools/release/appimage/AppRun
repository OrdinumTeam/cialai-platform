#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# AppRun do Cialai, gravado por tools/release/fix-appimage.mjs no lugar do AppRun do linuxdeploy.
#
# O AppRun anterior exportava PATH, LD_LIBRARY_PATH, PYTHONHOME, PYTHONPATH, PERLLIB e QT_PLUGIN_PATH, que
# os terminais e os agentes abertos pelo app herdavam. Aqui entra só o que o GTK e o WebKit do bundle usam:
# as bibliotecas são achadas pelo RUNPATH de cada ELF, ajustado no pós-processamento.
set -eu

APPDIR="$(dirname "$(readlink -f "$0")")"
export APPDIR
lib="$APPDIR/usr/lib/x86_64-linux-gnu"

# Temas GTK do sistema podem pedir um GTK mais novo que o do bundle; vale o Adwaita claro ou escuro.
if [ -z "${APPIMAGE_GTK_THEME:-}" ]; then
  variant=light
  if command -v gsettings >/dev/null 2>&1; then
    if gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | grep -q dark \
      || gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | grep -qi dark; then
      variant=dark
    fi
  fi
  APPIMAGE_GTK_THEME="Adwaita:$variant"
fi
export GTK_THEME="$APPIMAGE_GTK_THEME"

export GTK_DATA_PREFIX="$APPDIR"
export GTK_EXE_PREFIX="$APPDIR/usr"
# Só os módulos do bundle: os do sistema são compilados para um GTK e uma GLib mais novos.
export GTK_PATH="$lib/gtk-3.0"
export GTK_IM_MODULE_FILE="$lib/gtk-3.0/3.0.0/immodules.cache"
export GDK_PIXBUF_MODULE_FILE="$lib/gdk-pixbuf-2.0/2.10.0/loaders.cache"
export GSETTINGS_SCHEMA_DIR="$APPDIR/usr/share/glib-2.0/schemas"
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# Sem isso a GLib do bundle carrega os módulos GIO do sistema, como o libgvfsdbus.so, e falha com
# undefined symbol: g_task_set_static_name. O TLS do WebKit vem do libgiognutls.so do bundle.
export GIO_MODULE_DIR="$lib/gio/modules"
unset GIO_EXTRA_MODULES

# O WebKitGTK do bundle, do Ubuntu 22.04, cai no backend Wayland do GTK: tauri-apps/tauri#8541. Pelo X11,
# nativo ou XWayland, a janela também continua posicionável para a animação de abertura.
# CIALAI_GDK_BACKEND troca o backend para diagnóstico.
export GDK_BACKEND="${CIALAI_GDK_BACKEND:-x11}"

# O linuxdeploy-plugin-gtk troca /usr por ././ dentro da libwebkit2gtk, e o WebKit acha o WebKitWebProcess
# e o WebKitNetworkProcess por caminho relativo ao diretório de trabalho. O runtime do AppImage grava em OWD
# o diretório de onde o app foi aberto; na árvore extraída ele vem daqui.
OWD="${OWD:-$PWD}"
export OWD
cd "$APPDIR/usr"
exec "$APPDIR/usr/bin/cialai-desktop" "$@"
