{
  "name": "cialai-platform",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": "22.x", "npm": "10.x" },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "check:foundation": "node tools/check/foundation.mjs",
    "check:ci": "node tools/check/ci-matrix.mjs",
    "check:platform-docs": "node tools/check/platform-docs.mjs",
    "check:window": "node tools/check/desktop-window.mjs",
    "check:platform-css": "node tools/check/platform-css.mjs",
    "check:platform-preferences": "node tools/check/platform-preferences.mjs",
    "check:nightly": "node tools/check/nightly-e2e.mjs",
    "check:public-docs": "node tools/check/public-docs.mjs",
    "check:store-metadata": "node tools/check/store-metadata.mjs",
    "check:review-pack": "node tools/check/review-pack.mjs",
    "check:manual-mobile": "node tools/check/manual-mobile-runbooks.mjs",
    "check:release": "node tools/release/check-release.mjs",
    "check:living-docs": "node tools/check/living-docs.mjs",
    "check:css-cascade": "node tools/check/css-cascade.mjs",
    "dev:desktop": "npm run dev --workspace @cialai/desktop",
    "build:desktop": "npm run build --workspace @cialai/desktop",
    "build:tunnel": "node tools/build-tunnel.mjs",
    "test": "npm run check:foundation && npm run check:ci && npm run check:nightly && npm run check:platform-docs && npm run check:window && npm run check:platform-css && npm run check:platform-preferences && npm run check:public-docs && npm run check:store-metadata && npm run check:review-pack && npm run check:manual-mobile && npm run check:release && npm run check:living-docs && npm run test:i18n && npm run test:ui && npm run test:protocol && npm run test:desktop && npm run check:css-cascade && npm run test:tunnel && npm run test:mobile",
    "test:i18n": "npm run test --workspace @cialai/i18n",
    "test:ui": "npm run test --workspace @cialai/ui --if-present",
    "test:protocol": "npm run test --workspace @cialai/protocol --if-present",
    "test:desktop": "node tools/run.mjs desktop-check",
    "test:tunnel": "node tools/run.mjs tunnel-check",
    "test:mobile": "npm run test --workspace @cialai/mobile --if-present",
    "test:selftest": "node tools/selftest/run.mjs",
    "test:selftest:driver": "node tools/selftest/driver.mjs",
    "test:integration:headscale": "node tools/run.mjs integration-headscale",
    "test:spike:headscale": "node tools/run.mjs spike-headscale",
    "check:source": "node tools/check/control-source.mjs"
  }
}
